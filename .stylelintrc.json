{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "color-no-hex": true,
    "declaration-property-value-disallowed-list": {
      "/^(color|background|background-image|background-color|border|border-color|border-top|border-right|border-bottom|border-left|border-top-color|border-right-color|border-bottom-color|border-left-color|outline|box-shadow|fill|stroke|caret-color)$/": ["/rgba?\\(/", "/hsla?\\(/"]
    },

    "color-hex-length": null,
    "color-function-notation": null,
    "color-function-alias-notation": null,
    "alpha-value-notation": null,
    "custom-property-empty-line-before": null,
    "declaration-block-single-line-max-declarations": null,
    "selector-class-pattern": "^[a-z][a-zA-Z0-9]*$"
  },
  "overrides": [
    {
      "files": ["src/tokens/**/*.scss"],
      "rules": { "color-no-hex": null, "declaration-property-value-disallowed-list": null }
    }
  ]
}
